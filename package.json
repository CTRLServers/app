{
  "name": "ctrlservers",
  "version": "1.0.0",
  "description": "CTRLServers Desktop",
  "author": "We Are CTRLServers",
  "main": "electron.cjs",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test:mcp": "node mcp/server.test.mjs",
    "test:mcp-ui": "electron mcp/ui-smoke.cjs",
    "build": "electron-builder --publish never",
    "build:win": "electron-builder --win portable --publish never",
    "build:linux": "electron-builder --linux AppImage --publish never",
    "build:mac": "electron-builder --mac dmg --publish never"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "xyz.ctrlservers.desktop",
    "productName": "CTRLServers",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "nodeGypRebuild": false,
    "files": [
      "electron.cjs",
      "preload.js",
      "index.html",
      "styles.css",
      "js/**/*",
      "mcp/**/*",
      "!mcp/*.test.mjs",
      "!mcp/ui-smoke.cjs",
      "!mcp/ui-smoke.png",
      "node_modules/@xterm/addon-webgl/lib/addon-webgl.js",
      "assets/**/*",
      "src/**/*"
    ],
    "win": {
      "target": "portable",
      "icon": "src/assets/icon.ico",
      "artifactName": "${productName}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "icon": "src/assets/icon.icns",
      "artifactName": "${productName}.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "icon": "src/assets/logo.png",
      "artifactName": "${productName}.${ext}"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.0",
    "@modelcontextprotocol/server": "^2.2.0",
    "@xterm/addon-webgl": "^0.19.0",
    "discord-rpc": "^4.0.1",
    "ssh2": "^1.17.0",
    "ws": "^8.21.1",
    "zod": "^4.6.5"
  }
}
